# Nukopijuokite šį failą į .env vietiniam testavimui ("cp .env.example .env") ir įrašykite
# tikras reikšmes. PRODUKCIJOJE (Railway ir pan.) šie kintamieji nustatomi platformos "Variables"
# skiltyje, o ne šiame faile - .env NĖRA įtrauktas į git (žr. .gitignore).

# PostgreSQL prisijungimo eilutė. Railway'uje, pridėjus "PostgreSQL" plugin'ą prie projekto, jis
# automatiškai sukuria kintamąjį DATABASE_URL (arba DATABASE_PUBLIC_URL) - tiesiog susiekite jį
# su šiuo servisu per "Variable Reference" (žr. README.md).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/DBNAME"

# BŪTINA pakeisti į savo ilgą, atsitiktinę reikšmę produkcijoje - naudojama žaidėjų prisijungimo
# raktams (JWT) pasirašyti. Galite sugeneruoti su: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="pakeisk-mane-i-ilga-atsitiktine-reiksme"

# Portas, kuriuo klausosi serveris. Railway šį kintamąjį nustato automatiškai (PORT) - vietiniam
# testavimui galite palikti 8080.
PORT=8080

# Nustatykite į "true", jei jūsų PostgreSQL reikalauja SSL, o prisijungimo eilutėje nėra
# "sslmode=require" (kai kurie hostinimo providers to reikalauja atskirai).
# PGSSL=true
